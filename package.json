{
  "name": "cworks",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:playwright": "npx playwright test --project=chromium --reporter=json --output=research/reports/playwright-results",
    "audit:lighthouse:desktop": "npx lighthouse http://localhost:3000 --chrome-flags=\"--no-sandbox --headless\" --output=html --output-path=research/reports/lighthouse-desktop.html --emulated-form-factor=desktop",
    "audit:lighthouse:mobile": "npx lighthouse http://localhost:3000 --chrome-flags=\"--no-sandbox --headless\" --output=html --output-path=research/reports/lighthouse-mobile.html --emulated-form-factor=mobile",
    "audit:all": "npm run audit:lighthouse:desktop && npm run audit:lighthouse:mobile",
    "audit:a11y": "npx axe-core --help || echo \"axe unavailable; run a11y checks via Playwright axe plugin\""
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "aos": "^2.3.4",
    "axios": "^1.18.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.42.2",
    "gray-matter": "^4.0.3",
    "next": "16.2.10",
    "next-themes": "^0.4.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hot-toast": "^2.6.0",
    "react-slick": "^0.30.3",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "slick-carousel": "^1.8.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/aos": "^3.0.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-slick": "^0.23.13",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "node-fetch": "^2.7.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
